<Window x:Class="Dolgozatok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dolgozatok"
        Height="520"
        Width="720"
        MinHeight="450"
        MinWidth="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgDolgozatok"
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  Margin="0,0,0,25">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Név"
                                    Binding="{Binding Nev}"
                                    Width="120"/>

                <DataGridTextColumn Header="Életkor"
                                    Binding="{Binding Eletkor}"
                                    Width="65"/>

                <DataGridTextColumn Header="Pontszám"
                                    Binding="{Binding Pontszam}"
                                    Width="85"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1" Margin="5,15,5,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="0.7*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Content="Név:"
                   VerticalAlignment="Center"
                   FontSize="15"/>

            <TextBox x:Name="txtNev"
                     Grid.Column="1"
                     Height="35"
                     Margin="5,0,15,0"
                     VerticalContentAlignment="Center"
                     FontSize="15"/>

            <Label Grid.Column="2"
                   Content="Életkor:"
                   VerticalAlignment="Center"
                   FontSize="15"/>

            <TextBox x:Name="txtEletkor"
                     Grid.Column="3"
                     Height="35"
                     Margin="5,0,15,0"
                     VerticalContentAlignment="Center"
                     FontSize="15"/>

            <Label Grid.Column="4"
                   Content="Pontszám:"
                   VerticalAlignment="Center"
                   FontSize="15"/>

            <TextBox x:Name="txtPontszam"
                     Grid.Column="5"
                     Height="35"
                     Margin="5,0,0,0"
                     VerticalContentAlignment="Center"
                     FontSize="15"/>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <Button x:Name="btnHozzaadas"
                    Content="Hozzáadás"
                    Width="140"
                    Height="43"
                    FontSize="16"
                    Margin="0,0,15,0"
                    Click="btnHozzaadas_Click"/>

            <Button x:Name="btnMentes"
                    Content="Mentés"
                    Width="140"
                    Height="43"
                    FontSize="16"/>
        </StackPanel>
    </Grid>
</Window>
